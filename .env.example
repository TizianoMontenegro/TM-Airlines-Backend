# ==========================================
# TM Airlines Backend — Environment Config
# ==========================================
# Copy to .env and fill values:
#   cp .env.example .env

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins (your frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
# Set DATABASE_URL to a PostgreSQL URL to use Neon/PostgreSQL.
# Leave it as sqlite:///db.sqlite3 for local SQLite dev.
DATABASE_URL=sqlite:///db.sqlite3

# Uncomment and fill for self-hosted PostgreSQL (unused by default):
# DB_NAME=tm_airlines
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# TM-RAG Service Integration
# TM_RAG_API_KEY=generate-via-create-rag-service-user-command
